{
  "realm": "wikitop",
  "enabled": true,
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "verifyEmail": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "clients": [
    {
      "clientId": "wikitop",
      "name": "WikiTop play",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${WIKITOP_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["${PLAY_ORIGIN}/auth/callback"],
      "webOrigins": ["${PLAY_ORIGIN}"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "wiki",
      "name": "Wiki.js authors",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${WIKI_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["${WIKI_ORIGIN}/login/*"],
      "webOrigins": ["${WIKI_ORIGIN}"]
    }
  ]
}
