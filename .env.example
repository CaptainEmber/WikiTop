NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
DATABASE_URL=postgres://wikitop:change-play-password@localhost:5432/wikitop
WIKI_URL=http://localhost:3001
WIKI_INTERNAL_URL=http://localhost:3001
WIKI_API_KEY=replace-after-wiki-setup
WIKI_AUTH_PROVIDER_KEY=oidc
OIDC_ISSUER=http://localhost:8080/realms/wikitop
OIDC_CLIENT_ID=wikitop
OIDC_CLIENT_SECRET=replace-with-generated-client-secret
WIKI_OIDC_CLIENT_SECRET=replace-with-another-generated-client-secret
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=wikitop
S3_ACCESS_KEY=replace-access-key
S3_SECRET_KEY=replace-secret-key
PLAY_HOST=play.example.com
WIKI_HOST=wiki.example.com
AUTH_HOST=auth.example.com
ACME_EMAIL=you@example.com
PLAY_DB_PASSWORD=replace-play-db-password
WIKI_DB_PASSWORD=replace-wiki-db-password
AUTH_DB_PASSWORD=replace-auth-db-password
KEYCLOAK_ADMIN_PASSWORD=replace-admin-password
# Only allowed outside production. Never enable on a reachable hosted server.
DEV_AUTH=false
WIKI_MODE=remote

