{
  "name": "@wikitop/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "start": "tsx src/index.ts",
    "db:migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts",
    "wiki:check": "tsx src/check-wiki.ts",
    "storage:init": "tsx src/storage-init.ts",
    "users:provision": "tsx src/provision-users.ts",
    "migrate:coordinates": "tsx src/migrate-coordinates.ts"
  },
  "dependencies": {
    "@wikitop/shared": "workspace:*",
    "@aws-sdk/client-s3": "3.758.0",
    "@fastify/cookie": "11.0.2",
    "@fastify/multipart": "9.0.3",
    "@fastify/static": "8.1.1",
    "drizzle-orm": "0.40.0",
    "fastify": "5.2.1",
    "jose": "6.0.8",
    "pg": "8.14.1",
    "sharp": "0.33.5",
    "socket.io": "4.8.1",
    "tsx": "4.19.3",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/pg": "8.11.11"
  }
}
